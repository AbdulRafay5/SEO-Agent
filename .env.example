GEMINI_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
PEXELS_API_KEY=
# Optional private draft datastore
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main

# Optional live competitor search (provider quota and billing terms apply)
BRAVE_SEARCH_API_KEY=

# Optional single-owner protection (enable on private HTTPS deployments)
SEO_OWNER_AUTH=0
SEO_OWNER_USERNAME=
SEO_OWNER_PASSWORD=

# Optional remote versions; requires owner authentication and a private datastore
SEO_REMOTE_VERSIONS=0

# Optional public HTTPS page extraction (private owner workspace only)
SEO_WEB_EXTRACTION=0

# Optional Gemini embeddings for hybrid retrieval (provider quotas apply)
SEO_SEMANTIC_RETRIEVAL=0
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional process-local embedding cache; requires private owner authentication
SEO_EMBEDDING_CACHE=0

# Optional evidence persistence for authenticated owner workspaces only.
# Use a private GitHub datastore; source excerpts will be committed there.
SEO_REMOTE_EVIDENCE=0

# Separate guest deployment: no access to shared server articles or remote draft writes.
# Do not enable alongside SEO_OWNER_AUTH. Use a separate origin from your private workspace.
SEO_GUEST_MODE=0

# Optional account authentication foundation (setup/testing only; workspace disabled)
SEO_ACCOUNT_MODE=0
SEO_DATABASE_URL=
SEO_ACCOUNT_SETUP_KEY=
